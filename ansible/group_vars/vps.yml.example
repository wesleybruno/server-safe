---
# Copie para group_vars/vps.yml (gitignored) e preencha com os dados reais
# do deploy — sobrescreve os placeholders ficticios de roles/traefik/defaults.
# Aplica automaticamente a todo host do grupo [vps] do inventory.ini (nome
# do arquivo bate com o nome do grupo, convencao do Ansible).
traefik_dashboard_host: traefik.dominiodocliente.com
portainer_host: portainer.dominiodocliente.com
traefik_acme_email: ops@suaempresa.com
# Producao — so troque depois que o DNS acima ja apontar pro IP da VPS:
# traefik_acme_ca_server: https://acme-v02.api.letsencrypt.org/directory

# So necessario se for rodar app.yml (Database/API/Frontend) — troque
# tambem api_image/frontend_image (roles/api|frontend/defaults/main.yml)
# pela imagem real do projeto, os placeholders nao existem de verdade.
api_host: api.dominiodocliente.com
frontend_host: app.dominiodocliente.com
